{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "puzzle-mobile",
  "account_id": "08f8a12b720a01338f509cb25c7f86a5",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "alias": {
    "node-fetch": "./apps/api/src/providers/apple-node-fetch.ts"
  },
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "hiddenstage.app",
      "custom_domain": true
    }
  ],
  "upload_source_maps": true,
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "vars": {
    "AGE_ACCESS_REQUIRED": "new-apps",
    "ENVIRONMENT": "production",
    "LOCAL_DEV_TOOLS": "disabled",
    "CLIENT_ORIGINS": "capacitor://localhost,http://localhost,https://localhost,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173",
    "ASSET_VERSION": "garden-2026.11.03-activity-v14",
    "ASSET_PUBLIC_ORIGIN": "",
    "GOOGLE_CLIENT_IDS": "340736621536-c4d4s18jd1l2t8lp5ug0htvjt2b28959.apps.googleusercontent.com,340736621536-gldihfkfalvc6n4b83i3ll0shi615v2s.apps.googleusercontent.com",
    "APPLE_CLIENT_IDS": "com.cloudgarden.match",
    "APPLE_TEAM_ID": "85NYTV836Q",
    "APPLE_AUTH_KEY_ID": "Z5R5JRZDQF",
    "GOOGLE_PACKAGE_NAME": "com.cloudgarden.match",
    "GOOGLE_IAP_ENVIRONMENT": "Sandbox",
    "APPLE_BUNDLE_ID": "com.cloudgarden.match",
    "ADMOB_HEART_AD_UNIT": "",
    "ADMOB_COIN_AD_UNIT": "",
    "ADMOB_AD_UNITS": "ca-app-pub-8278526737142254/9847446642,ca-app-pub-8278526737142254/4199921188",
    "ADMOB_REWARD_ITEMS": "reward,Reward",
    "ADMIN_OWNER_EMAILS": "hiddenstagedev@gmail.com",
    "ADMOB_ENABLED": "true",
    "ADMOB_ANDROID_HEART_AD_UNIT": "ca-app-pub-8278526737142254/9847446642",
    "ADMOB_ANDROID_COIN_AD_UNIT": "ca-app-pub-8278526737142254/9847446642",
    "ADMOB_IOS_HEART_AD_UNIT": "ca-app-pub-8278526737142254/4199921188",
    "ADMOB_IOS_COIN_AD_UNIT": "ca-app-pub-8278526737142254/4199921188"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "puzzle-mobile-db",
      "database_id": "d4a903ca-b1d5-4cb9-b106-3ca6eded1c73",
      "migrations_dir": "apps/api/migrations"
    }
  ],
  "send_email": [
    {
      "name": "GUARDIAN_EMAIL",
      "allowed_sender_addresses": ["consent@hiddenstage.app"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "puzzle-mobile-assets"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GUILD_ROOMS",
        "class_name": "GuildRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GuildRoom"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "assets": {
    "directory": "apps/admin/dist",
    "binding": "ADMIN_ASSETS",
    "run_worker_first": true
  }
}
