{
  "name": "cloud-garden-match",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,client \"npm run dev:api\" \"npm run dev:client\"",
    "dev:client": "vite --config apps/client/vite.config.ts --host 0.0.0.0",
    "dev:api": "node tools/local-api.mjs",
    "db:migrate": "wrangler d1 migrations apply cloud-garden --local --config apps/api/wrangler.jsonc",
    "build": "npm run typecheck && vite build --config apps/client/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assets": "node --import tsx tools/asset-pipeline/build.ts",
    "levels:validate": "node --import tsx tools/level-validation/validate.ts",
    "api:types": "wrangler types --config wrangler.jsonc apps/api/worker-configuration.d.ts",
    "api:check": "wrangler deploy --dry-run --config apps/api/wrangler.jsonc --outdir output/worker",
    "api:check:production": "wrangler deploy --dry-run --config wrangler.jsonc --outdir output/worker-production",
    "db:migrate:remote": "wrangler d1 migrations apply puzzle-mobile-db --remote --config wrangler.jsonc",
    "deploy": "npm run db:migrate:remote && wrangler deploy --config wrangler.jsonc",
    "native:sync": "npm run build && cap sync",
    "native:local": "node tools/native-build.mjs local",
    "native:release": "node tools/native-build.mjs release",
    "native:ios-simulator": "sh tools/native-ios-simulator.sh",
    "levels:campaign:build": "node --import tsx tools/level-validation/campaign-build.ts",
    "levels:campaign:verify": "node --import tsx tools/level-validation/campaign-build.ts --verify",
    "levels:bulk:build": "node --import tsx tools/level-validation/bulk-build.ts",
    "levels:bulk:verify": "node --import tsx tools/level-validation/bulk-build.ts --verify"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "@capacitor-community/admob": "8.3.0",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.0",
    "@capacitor/preferences": "8.0.1",
    "@capgo/capacitor-social-login": "8.7.5",
    "@capgo/native-purchases": "8.9.6",
    "capacitor-secure-storage-plugin": "0.13.0",
    "jose": "6.2.15",
    "pixi.js": "8.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@cloudflare/workers-types": "5.20261102.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.156.1"
  }
}
