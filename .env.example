# Client PUBLIC build config (copy to .env; no provider secrets here).
# Blank: deployed Worker for release/web builds; local /api proxy for Vite dev.
# Public deployment default is stored in config/deployment.json.
VITE_API_URL=
# Optional immutable custom-domain asset origin; blank uses bundled images.
VITE_ASSET_ORIGIN=
VITE_ASSET_VERSION=garden-2026.11.03-local-v13
VITE_GOOGLE_WEB_CLIENT_ID=
VITE_GOOGLE_IOS_CLIENT_ID=
VITE_APPLE_SERVICE_ID=
VITE_APPLE_REDIRECT_URL=
VITE_ENABLE_ADS=false
VITE_ADS_TEST_MODE=true
VITE_ENABLE_PURCHASES=false
# Enabled automatically by native:local, forced disabled by native:release.
# Browser Vite development also allows the UI; the local Worker capability is required.
VITE_LOCAL_DEV_TOOLS=disabled

# Worker secret/config names. Set via wrangler secret put or apps/api/.dev.vars.
# Never prefix these with VITE_. Placeholder values are not working credentials.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
APPLE_TEAM_ID=
APPLE_AUTH_KEY_ID=
APPLE_AUTH_PRIVATE_KEY=
APPLE_AUTH_CLIENT_ID=
APPLE_AUTH_REDIRECT_URL=
# Workers secret: 32 random bytes encoded as unpadded base64url; never VITE_.
AUTH_TOKEN_ENCRYPTION_KEY=
# Deployment default must stay disabled. npm run dev:api enables only local workerd.
LOCAL_DEV_TOOLS=disabled
GOOGLE_PACKAGE_NAME=com.cloudgarden.match
GOOGLE_IAP_ENVIRONMENT=Sandbox
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_RTDN_AUDIENCE=
GOOGLE_RTDN_EMAIL=
APPLE_BUNDLE_ID=com.cloudgarden.match
APPLE_APP_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_ENVIRONMENT=Sandbox
# Optional override; official public Apple roots are bundled.
# APPLE_ROOT_CA_PEMS=["-----BEGIN CERTIFICATE-----..."]
# Each AdMob unit is configured to return reward_amount=1, reward_item=reward.
ADMOB_AD_UNITS=
ADMOB_REWARD_ITEMS=reward
